{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgeCrate"
  ],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "description": "@types/node follows the Node.js major in .node-version and is raised by hand with it.",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Review every Node.js update separately because it changes the contributor toolchain; coordinate wrangler.toml and @types/node when needed.",
      "matchManagers": ["nodenv"],
      "dependencyDashboardApproval": true,
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Review every pnpm update separately because it changes the contributor toolchain; coordinate wrangler.toml when needed.",
      "matchDepTypes": ["packageManager"],
      "dependencyDashboardApproval": true,
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Keep Tauri npm packages and Rust crates in a separate, manually merged PR because CI does not run the desktop app.",
      "matchPackageNames": ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-*"],
      "groupName": "Tauri",
      "groupSlug": "tauri",
      "automerge": false
    }
  ],
  "automerge": false,
  "platformAutomerge": false,
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "dependencyDashboardApproval": true
  },
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "automerge": false,
    "dependencyDashboardApproval": true
  },
  "dependencyDashboardApproval": true
}
