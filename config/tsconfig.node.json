{
  "extends": "./tsconfig.base.json",
  "include": [
    "./*.ts",
    "./scripts/**/*.mjs",
    "../src/shared/example-catalog.ts",
    "../src/shared/third-party-notices.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022"],
    "types": ["node"]
  }
}
