{
  "version": 1,
  "name": "CanvaSlide 소개",
  "elements": {
    "frame-01": {
      "id": "frame-01",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 720,
      "name": "01 · 표지 / 하나의 캔버스, 다양한 시선",
      "order": 1,
      "transition": {
        "ms": 900,
        "easing": "decelerate",
        "arc": 0.8
      }
    },
    "frame-02": {
      "id": "frame-02",
      "type": "frame",
      "x": 1900,
      "y": -560,
      "width": 1280,
      "height": 720,
      "name": "02 · 이야기의 세 단계",
      "order": 2,
      "transition": {
        "ms": 1700,
        "easing": "smooth",
        "arc": 2.2,
        "roll": 2
      }
    },
    "frame-03": {
      "id": "frame-03",
      "type": "frame",
      "x": 3700,
      "y": 260,
      "width": 1280,
      "height": 720,
      "name": "03 · 핵심 기능과 캔버스",
      "order": 3,
      "transition": {
        "ms": 1300,
        "easing": "overshoot",
        "arc": 1.5,
        "roll": 0
      }
    },
    "frame-04": {
      "id": "frame-04",
      "type": "frame",
      "x": 4360,
      "y": 460,
      "width": 560,
      "height": 315,
      "name": "04 · 내부 확대 / 프레임이 곧 장면",
      "order": 4,
      "transition": {
        "ms": 1000,
        "easing": "accelerate",
        "arc": 0.7,
        "roll": 0,
        "spotlight": 0.55
      }
    },
    "frame-05": {
      "id": "frame-05",
      "type": "frame",
      "x": 2200,
      "y": 1420,
      "width": 1280,
      "height": 720,
