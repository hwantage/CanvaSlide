{
  "extends": "./tsconfig.base.json",
  "include": [
    "../src/renderer/src/**/*",
    "../src/shared/**/*",
    "../src/player/**/*",
    "../src/cloud-share/**/*",
    "../functions/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@shared/*": ["../src/shared/*"]
    }
  }
}
