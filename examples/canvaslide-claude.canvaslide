        "ms": 1800,
        "easing": "smooth",
        "arc": 2.6,
        "roll": -3
      }
    },
    "frame-06": {
      "id": "frame-06",
      "type": "frame",
      "x": 2860,
      "y": 1610,
      "width": 560,
      "height": 315,
