{
  "name": "canvaslide",
  "version": "0.7.0",
  "private": true,
  "description": "Infinite canvas with presentation frames (Tauri + React)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:site": "vite --config website/vite.config.ts",
    "build:site": "pnpm run tc:site && vite build --config website/vite.config.ts",
    "preview:site": "vite preview --config website/vite.config.ts",
    "tc:site": "tsc --noEmit -p website/tsconfig.json",
    "test:site": "pnpm run build:site && playwright test --config website/playwright.config.ts",
    "dev": "tauri dev",
    "dev:cloud": "pnpm run build:web && wrangler pages dev dist --kv=SHARED_DOCUMENTS --port 8788 --compatibility-date=2026-09-19",
    "dev:web": "pnpm run build:player && pnpm run build:pdfjs && vite --config config/vite.config.ts --host 127.0.0.1",
    "build:web": "pnpm run build:player && pnpm run build:pdfjs && tsc --noEmit -p config/tsconfig.web.json && vite build --config config/vite.config.ts",
    "bundle:local": "tauri build --no-sign",
    "preview:web": "vite preview --config config/vite.config.ts",
    "tauri": "tauri",
    "tc": "pnpm run typecheck",
    "tc:web": "pnpm run build:player && tsc --noEmit -p config/tsconfig.web.json",
    "tc:node": "tsc --noEmit -p config/tsconfig.node.json",
    "typecheck": "pnpm run tc:web && pnpm run tc:node && pnpm run tc:e2e && pnpm run tc:examples && pnpm run tc:site",
    "lint": "oxlint && pnpm run check:max-lines && pnpm run check:control-characters",
    "lint:fix": "oxlint --fix",
    "check:max-lines": "node config/scripts/check-max-lines.mjs",
    "check:control-characters": "node config/scripts/check-control-characters.mjs",
    "check:player-size": "node config/scripts/check-player-size.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run test:tooling && vitest run --config config/vitest.config.ts",
    "test:tooling": "node --test config/scripts/*.test.mjs",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "prepare": "husky",
    "tc:e2e": "tsc --noEmit -p config/tsconfig.e2e.json",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "build:player": "vite build --config config/vite.player.config.ts && pnpm run check:player-size",
    "build:pdfjs": "node config/scripts/copy-pdfjs-assets.mjs",
    "tc:examples": "tsc --noEmit -p config/tsconfig.examples.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "kiwi-schema": "0.5.0",
    "lucide-react": "^1.45.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.134.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts,cts}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,css,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
