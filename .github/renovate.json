{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgeCrate"
  ],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "description": "Keep GitHub Actions major upgrades together for manual review; SHA pinning is inherited from the helper preset.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "@types/node follows the Node.js major in .node-version and is raised by hand with it.",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Node.js and pnpm majors also change NODE_VERSION or PNPM_VERSION in wrangler.toml, and @types/node for Node.js, by hand, so their pull requests open only when approved on the Dependency Dashboard.",
      "matchManagers": ["nodenv"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "See the Node.js rule above.",
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group weekly non-major updates across managers and merge after required CI passes; later rules separate pre-1.0 minors and Tauri.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major-dependencies",
      "automerge": true
    },
    {
      "description": "Pre-1.0 minors may break APIs, so keep each outside the shared group while allowing CI-gated automerge.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": null,
      "groupSlug": null,
      "automerge": true
    },
    {
      "description": "Keep Tauri npm packages and Rust crates in a separate, manually merged PR because CI does not run the desktop app.",
      "matchPackageNames": ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-*"],
      "groupName": "Tauri",
      "groupSlug": "tauri",
      "automerge": false
    }
  ],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "separateMinorPatch": false
}
