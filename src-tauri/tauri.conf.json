{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanvaSlide",
  "version": "../package.json",
  "identifier": "com.hwantage.canvaslide",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CanvaSlide",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.youtube.com https://s.ytimg.com https://player.vimeo.com; connect-src 'self' ipc: http://ipc.localhost https://www.youtube.com https://vimeo.com; frame-src https://www.youtube.com https://player.vimeo.com http://127.0.0.1:*; media-src 'self' https: http:; img-src 'self' data: blob: https://i.ytimg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/hwantage/CanvaSlide/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NTNFMENEQTQzQ0QzRkUKUldUKzB6eWt6ZUJUTnJBcXRDNTJQT3pha2ZpaWFtMnZrT1Y2cnZnbHlYYmlKanlKM1hoOVBuVU4K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["canvaslide"],
        "name": "CanvaSlide Document",
        "description": "CanvaSlide canvas presentation document",
        "role": "Editor",
        "mimeType": "application/vnd.canvaslide+json"
      }
    ],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
